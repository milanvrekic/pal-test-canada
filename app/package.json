{
  "name": "pal-test-canada",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.29",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "content": "node ../tools/compile-content.mjs",
    "content:preview": "node ../tools/compile-content.mjs --allow-drafts",
    "start": "npm run content:preview && expo start",
    "web": "npm run content:preview && expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:web": "npm run content && expo export --platform web && node ../tools/sitemap.mjs dist",
    "build:web:preview": "npm run content:preview && expo export --platform web && node ../tools/sitemap.mjs dist",
    "test": "node --test --experimental-strip-types src/features/*/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "private": true
}
